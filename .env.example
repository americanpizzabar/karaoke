# Turso (libSQL) — https://turso.tech
# 未設定でもアプリは動作します(曲リスト=同梱データ、測定記録=端末内保存のローカルモード)。
# 設定する場合は `turso db show <db名> --url` の実際の出力をそのまま貼り付けてください。
# <...> のようなプレースホルダのまま設定すると Invalid URL で全APIが失敗します。
# TURSO_DATABASE_URL="libsql://onikiattack-yourorg.turso.io"
# TURSO_AUTH_TOKEN="eyJ..."

# 匿名ユーザーCookie署名用シークレット(本番では必ず設定)
AUTH_SECRET="change-me"
